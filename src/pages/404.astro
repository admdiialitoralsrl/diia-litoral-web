---
import Base from "@/layouts/Base.astro";
---

<Base title="Página no encontrada" noindex>
  <section class="section">
    <div class="container">
      <div class="flex min-h-[40vh] items-center justify-center">
        <div class="text-center">
          <p class="eyebrow">Error 404</p>
          <h1 class="h2 mt-3">No encontramos esta página</h1>
          <p class="mt-4">Puede que la dirección haya cambiado. Estas secciones pueden ayudarlo:</p>
          <div class="mt-8 flex flex-wrap justify-center gap-3">
            <a href="/productos" class="btn btn-primary">Ver productos</a>
            <a href="/contacto" class="btn btn-outline-primary">Contacto</a>
          </div>
        </div>
      </div>
    </div>
  </section>
</Base>
