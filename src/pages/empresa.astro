---
import { Image } from "astro:assets";
import Base from "@/layouts/Base.astro";
import Icono from "@/components/Icono.astro";
import CtaContacto from "@/components/CtaContacto.astro";
import { foto } from "@/lib/imagenes";

const valores = [
  { icono: "asesoria", titulo: "Asesoramiento técnico", texto: "Entendemos el proceso de cada cliente para recomendarle el insumo y el grado adecuados." },
  { icono: "calidad", titulo: "Calidad", texto: "Trabajamos con insumos de alta calidad, porque de ellos depende el producto final de nuestros clientes." },
  { icono: "entrega", titulo: "Cercanía", texto: "Desde Santa Fe, con trato directo y respuestas rápidas para la industria de la región." },
];
---

<Base
  title="Nuestra empresa"
  description="Diia Litoral SRL: distribuidora de insumos químicos fundada en 2006 en Santa Fe. Historia, misión y visión."
>
  <section class="section">
    <div class="container">
      <div class="mx-auto max-w-[720px] text-center">
        <p class="eyebrow">Nuestra empresa</p>
        <h1 class="mt-3 font-bold">20 años acompañando a la industria</h1>
        <p class="lead mt-4">Insumos químicos y asesoramiento técnico para las industrias alimenticia, farmacéutica, cosmética y de tratamiento de aguas.</p>
      </div>
      <div class="hero-media mx-auto mt-12 max-w-[980px]">
        <Image src={foto("deposito.jpg")} widths={[600, 1000, 1500]} sizes="(max-width: 1000px) 100vw, 980px" alt="Depósito de Diia Litoral" loading="eager" />
      </div>
    </div>
  </section>

  <section class="section pt-0">
    <div class="container">
      <div class="gap-14 md:grid md:grid-cols-[1fr_1fr]">
        <div>
          <h2 class="h3">¿Cómo comenzamos?</h2>
          <div class="linea-tiempo mt-8">
            <div class="hito">
              <p class="anio">2006</p>
              <p class="mt-2">
                Marcelo Paniccia funda una empresa dedicada a la distribución de productos químicos. Al detectar que las empresas no solo necesitaban insumos sino también asesoramiento técnico, decide ofrecer un servicio integral, construyendo un vínculo estrecho con cada cliente y comprendiendo a fondo sus desafíos y necesidades.
              </p>
            </div>
            <div class="hito">
              <p class="anio">2022</p>
              <p class="mt-2">
                Con una visión de crecimiento sostenido, la empresa se convierte en DIIA LITORAL SRL, suma nuevos socios estratégicos y amplía su oferta de servicios. Comienza así una nueva etapa, orientada a la innovación, la diversificación y la excelencia.
              </p>
            </div>
            <div class="hito">
              <p class="anio">Hoy</p>
              <p class="mt-2">
                Somos socios estratégicos de la industria de la provincia y proyectamos ampliar nuestro alcance hacia los países limítrofes.
              </p>
            </div>
          </div>
        </div>
        <div class="mt-12 grid content-start gap-5 md:mt-0">
          <div class="rounded-2xl bg-light p-7">
            <p class="eyebrow">Nuestra misión</p>
            <p class="mt-3 text-lg text-text-dark">
              Distribuir insumos químicos para la cadena de producción de sectores como el alimenticio, farmacéutico, cosmético y de tratamiento de aguas, ofreciendo soporte técnico especializado para optimizar los procesos productivos.
            </p>
          </div>
          <div class="rounded-2xl bg-text-dark p-7">
            <p class="eyebrow">Nuestra visión</p>
            <p class="mt-3 text-lg text-white">
              Mantener el liderazgo alcanzado en 20 años de trayectoria a nivel provincial y contribuir al crecimiento de las industrias en la mejora continua de sus procesos, ampliando nuestro alcance hacia países limítrofes.
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="section bg-light">
    <div class="container">
      <h2 class="h3 text-center">Lo que nos distingue</h2>
      <div class="mt-10 grid gap-5 md:grid-cols-3">
        {
          valores.map((v) => (
            <div class="industria">
              <div class="industria-icon"><Icono nombre={v.icono} /></div>
              <h3 class="h5">{v.titulo}</h3>
              <p class="text-[15px]">{v.texto}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <CtaContacto />
</Base>
